# Для Vercel заполните эти значения в Settings → Environment Variables.
# Не загружайте настоящий .env в Git.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Пароль первого администратора: минимум 12 символов на Vercel.
# При смене переменной пароль существующего аккаунта не меняется.
ADMIN_PASSWORD=
# Необязательно. По умолчанию admin / Админ.
ADMIN_LOGIN=admin
ADMIN_NAME=Админ
# Только для локального запуска без Turso:
DB_FILE=data.db
PORT=3000
